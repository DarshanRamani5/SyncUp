PORT=5000

# Supabase PostgreSQL - Transaction mode (for Prisma queries via PgBouncer)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL - Session mode (for Prisma migrations)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

PORT=5000
JWT_SECRET=
FRONTEND_URL="http://localhost:5173"
DATABASE_URL=
DIRECT_URL=

REDIS_URL=

# Cloudinary — for image uploads (file sharing)
# Get these from Cloudinary Console → Dashboard → Product Environment Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Aiven Kafka — get these from Aiven Console → Your Kafka Service → Connection Information
AIVEN_KAFKA_HOST=
AIVEN_KAFKA_USERNAME=
AIVEN_KAFKA_PASSWORD=
# Also download ca.pem from Aiven dashboard and place it in the server/ root directory

# Brevo (email) — for OTP verification emails
# Get your API key from Brevo Dashboard → SMTP & API → API Keys
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@syncup.app
BREVO_SENDER_NAME=SyncUp