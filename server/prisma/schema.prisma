generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =========================================
// User Model
// =========================================
// Supports traditional auth (email/password with bcrypt)
// Has friends system, conversations, and message relations
model User {
  id           String  @id @default(cuid()) @db.VarChar(30)
  name         String? @db.VarChar(200)
  email        String  @unique

  // Unique public handle (Discord/Telegram style, e.g. "darshan_dev")
  // - Optional (String?) at the DB level so existing rows don't break the
  //   migration, but REQUIRED at registration time (enforced in the controller).
  // - Always stored lowercase so "Darshan_Dev" and "darshan_dev" can't both exist.
  // - This is what users share publicly instead of their email.
  username     String? @unique @db.VarChar(32)

  passwordHash String
  avatarUrl    String?
  color        String? @db.VarChar(8)

  // Whether the user has verified their email via OTP
  emailVerified Boolean @default(false)

  // Friends system — self-referencing many-to-many
  // A user can be on either side of a friendship
  friendsWith User[] @relation("Friends")
  friendOf    User[] @relation("Friends")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Conversations this user is part of (via join table)
  conversations ConversationsOnUsers[]

  // Friend requests sent and received
  requestSent     FriendRequest[] @relation("FriendRequestsSent")
  requestReceived FriendRequest[] @relation("FriendRequestsReceived")

  // Messages this user has seen (many-to-many)
  seenMessages Message[] @relation("seen")

  // Messages this user has deleted for themselves (many-to-many)
  deletedMessages Message[] @relation("deleted_for_user")

  // Messages this user has sent
  messages Message[] @relation("sent_messages")
}

// =========================================
// Friend Request System
// =========================================
enum FriendRequestStatus {
  accepted
  declined
  pending
}

model FriendRequest {
  id         Int                 @id @default(autoincrement())
  senderId   String              @db.VarChar(30)
  receiverId String              @db.VarChar(30)
  sender     User                @relation("FriendRequestsSent", fields: [senderId], references: [id])
  receiver   User                @relation("FriendRequestsReceived", fields: [receiverId], references: [id])
  status     FriendRequestStatus @default(pending)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  // A user can only have ONE request row per receiver.
  // Prevents spamming someone with 50 pending requests.
  @@unique([senderId, receiverId])
}

// =========================================
// Conversation ↔ User Join Table
// =========================================
// Composite primary key (userId + conversationId).
// isAdmin: group admin flag. The group creator becomes admin;
// only admins can rename the group, add members, or remove members.
model ConversationsOnUsers {
  user           User         @relation(fields: [userId], references: [id])
  userId         String       @db.VarChar(30)
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String       @db.Uuid
  isAdmin        Boolean      @default(false)

  @@id([userId, conversationId])
}

// =========================================
// Conversation Model
// =========================================
model Conversation {
  id            String                 @id @default(uuid()) @db.Uuid
  name          String?
  isGroup       Boolean?               @default(false)
  image         String?
  users         ConversationsOnUsers[]
  createdAt     DateTime               @default(now())
  lastMessageAt DateTime               @default(now())
  messages      Message[]

  @@index([createdAt])
}

// =========================================
// Message Model
// =========================================
model Message {
  id        String  @id @default(uuid())
  body      String?
  image     String?
  public_id String?

  // Many-to-many: which users have seen this message
  seenBy User[] @relation("seen")

  // Many-to-many: which users have deleted this message for themselves
  deletedBy User[] @relation("deleted_for_user")

  // Sender relation
  userId    String @db.VarChar(30)
  createdBy User   @relation("sent_messages", fields: [userId], references: [id])

  // Conversation relation
  conversationId String       @db.Uuid
  Conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Reply threading (WhatsApp style) — self-relation.
  // replyToId points at the quoted message. SetNull on delete so that if
  // the original is ever hard-deleted, replies survive with a null quote.
  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  isEdited  Boolean? @default(false)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId, createdAt])
}

// =========================================
// OTP Verification Token (for email verification / password reset)
// =========================================
// One active token per email per type. The `otp` field holds the 6-digit code
// (hashed with bcrypt). `attempts` tracks wrong guesses to prevent brute-force.
model VerificationToken {
  identifier String              // email address
  type       String              // "email_verification" | "password_reset"
  otp        String              // bcrypt-hashed 6-digit OTP
  expires    DateTime
  attempts   Int      @default(0) // wrong-guess counter (lock after 5)
  createdAt  DateTime @default(now())

  @@id([identifier, type])
}